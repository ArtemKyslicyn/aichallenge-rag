# Copy to .env and fill locally. Never commit real keys.

RAG_HOST=127.0.0.1
RAG_PORT=18766
RAG_SHARED_TOKEN=

# Index persistence + documents to index on startup / POST /v1/index
RAG_DATA_DIR=./data
RAG_CORPUS_DIR=./corpus

# Qdrant: leave URL empty for embedded store under RAG_DATA_DIR/qdrant
QDRANT_URL=
QDRANT_COLLECTION=aichallenge_rag

# Chunking: fixed | structural
RAG_CHUNK_STRATEGY=structural
RAG_FIXED_SIZE=800
RAG_FIXED_OVERLAP=120

# Retrieval defaults
RAG_TOP_K=6
RAG_TOP_K_PRE=20
RAG_TOP_K_POST=6
RAG_MIN_SCORE=0.18
# raw | filtered | full
RAG_MODE=full

# Embeddings: api | local | fake
# api needs LLM_API_KEY or ROUTERAI_KEY; without a key the service falls back to fake
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=64
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
ROUTERAI_KEY=

# Optional local sentence-transformers (needs: uv sync --extra local)
LOCAL_EMBEDDINGS_ENABLED=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
